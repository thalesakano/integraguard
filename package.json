{
  "name": "integraguard",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @integraguard/web dev",
    "build": "pnpm -r --filter './packages/**' --filter './sandbox' build",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "sandbox": "pnpm --filter @integraguard/sandbox dev",
    "eval:baseline": "tsx scripts/eval.ts baseline",
    "eval:final": "tsx scripts/eval.ts final",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "scenarios:seed": "tsx scripts/seed-scenarios.ts",
    "changelog:update": "tsx scripts/update-changelog.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@integraguard/evaluator": "workspace:*",
    "@integraguard/schemas": "workspace:*",
    "@integraguard/workflow": "workspace:*",
    "yaml": "^2.6.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
